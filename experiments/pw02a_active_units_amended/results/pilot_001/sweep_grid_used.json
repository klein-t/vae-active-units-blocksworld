{
 "note": "pw02a amended sweep (pilot-triggered amendment of pw02_active_units, registered 2026-10-21 before any confirmation data was opened): A3 (4x256) cells removed (8 cells, 36 runs); 60,000 steps for every cell; linear KL warm-up (beta 0 -> target over the first 10% of steps = 6,000) for every cell, kept because the pw02 A3 contingency fired; weights snapshotted at 80% of steps (48,000) for the amended convergence check. Everything else as frozen in pw02. Frozen shared training sweep for pw02-pw04 (trained once, in pw02). Deterministic baselines (PCA) are not cells. Pre-freeze change 2026-10-14: per-cell seeds; width-128 activation sources at three transformer seeds (w128 = d4_w128_s1, w128s2, w128s3).",
 "architectures": {
  "A1": {
   "hidden": [
    64
   ],
   "activation": "relu",
   "note": "encoder hidden widths; decoder mirrors"
  },
  "A2": {
   "hidden": [
    256,
    256
   ],
   "activation": "relu",
   "note": "encoder hidden widths; decoder mirrors"
  },
  "A4": {
   "hidden": [
    1024,
    1024
   ],
   "activation": "relu",
   "note": "encoder hidden widths; decoder mirrors"
  }
 },
 "training": {
  "optimizer": "adam",
  "steps": 60000,
  "batch_size": 512,
  "lr_schedule": "constant",
  "kl_warmup": {
   "schedule": "linear",
   "fraction": 0.1
  },
  "grad_clip_norm": 10.0,
  "logvar_clamp": [
   -12.0,
   6.0
  ],
  "log_gamma_floor": -9.0,
  "eval_every_steps": 1000,
  "convergence_snapshot_fraction": 0.8
 },
 "families": {
  "gauss_vae": "beta-VAE: N(0,I) prior, diagonal Gaussian posterior; decoder Bernoulli (bw, code10, prod5, indep) or Gaussian with scalar variance gamma (b_*; gamma learned as log-parameter init 0 with floor, or fixed 1)",
  "tc_vae": "beta-TCVAE (Chen et al. 2018), minibatch-weighted sampling estimator, alpha=1 (index-code MI), gamma_kl=1 (dimension-wise KL), beta = weight on total correlation; total correlation reported in nats by MWS with the Chen constants and by MSS (docs/METRICS_SPEC.md section 4)",
  "cat_vae": "16 categorical latents x 6 classes, Gumbel-softmax relaxed samples (Jang et al. recipe): tau = max(0.5, exp(-3e-5 t)) with t updated every 1,000 steps, analytic KL to the uniform categorical weighted by beta; evaluation uses posterior probabilities and hard argmax codes",
  "topk_sae": "Top-k SAE (Gao et al. 2024 recipe): pre-bias = train mean, unit-norm decoder columns renormalised each step, encoder initialised as decoder transpose, AuxK loss (k_aux = latent/2, coefficient 1/32) on latents dead for >= 1000 steps; MSE loss",
  "plain_ae": "deterministic autoencoder, same MLP and latent size as the gauss_vae reference, no KL term; Bernoulli/BCE (bw) or MSE (b_*)"
 },
